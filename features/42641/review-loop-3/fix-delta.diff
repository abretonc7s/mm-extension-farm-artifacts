+  if (estimatedPct < SLIPPAGE_DISPLAY_FLOOR_PCT) {
+    return `<${SLIPPAGE_DISPLAY_FLOOR_PCT}%`;
   }
   return `${estimatedPct.toFixed(2)}%`;
 }
