{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Prove abandoned Perps search analytics",
  "description": "Search for a missing market and clear the real input to prove the unresolved search is reported exactly once.",
  "paramsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "missing_query": {
        "type": "string",
        "default": "no_such_perp",
        "description": "Lowercase query expected to return no Perps markets."
      }
    }
  },
  "proofTargets": [
    {
      "id": "search-abandon-analytics",
      "claim": "A no-result query and its explicit clear emit the no-results and abandonment contracts exactly once."
    }
  ],
  "workflow": {
    "entry": "reset",
    "nodes": {
      "reset": {
        "action": "ui.navigate",
        "hash": "#/",
        "intent": "Unmount any prior search session before the proof",
        "next": "open-list"
      },
      "open-list": {
        "action": "ui.navigate",
        "hash": "#/perps/market-list",
        "intent": "Open the live Perps market list",
        "next": "list-ready"
      },
      "list-ready": {
        "action": "ui.wait_for",
        "test_id": "search-input",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Prove the searchable market list settled",
        "next": "capture"
      },
      "capture": {
        "action": "metamask.analytics.start_capture",
        "intent": "Bracket the abandoned search",
        "next": "search"
      },
      "search": {
        "action": "ui.set_input",
        "test_id": "search-input",
        "value": "{{params.missing_query}}",
        "intent": "Search for a market that cannot match",
        "next": "assert-empty"
      },
      "assert-empty": {
        "action": "metamask.analytics.assert_events",
        "since": "{{outputs.capture.cursor}}",
        "timeout_ms": 15000,
        "settle_ms": 1000,
        "expect": [
          {
            "event": "Perp Search Query",
            "count": 1
          },
          {
            "event": "Perp Search Query",
            "count": 1,
            "properties": {
              "search_query": "{{params.missing_query}}",
              "results_count": 0,
              "has_results": false
            }
          },
          {
            "event": "Perp Screen Viewed",
            "count": 1
          },
          {
            "event": "Perp Screen Viewed",
            "count": 1,
            "properties": {
              "screen_type": "search_no_results",
              "search_query": "{{params.missing_query}}",
              "result_count": 0
            }
          }
        ],
        "intent": "Prove the no-results state is measured",
        "next": "clear",
        "proves": [
          "search-abandon-analytics"
        ]
      },
      "clear": {
        "action": "ui.press",
        "test_id": "text-field-search-clear-button",
        "intent": "Clear the unresolved query through the real input",
        "next": "assert-abandoned"
      },
      "assert-abandoned": {
        "action": "metamask.analytics.assert_events",
        "since": "{{outputs.capture.cursor}}",
        "timeout_ms": 15000,
        "settle_ms": 1500,
        "expect": [
          {
            "event": "Perp Search Abandoned",
            "count": 1
          },
          {
            "event": "Perp Search Abandoned",
            "count": 1,
            "properties": {
              "search_query": "{{params.missing_query}}",
              "results_count": 0,
              "query_count": 1
            }
          }
        ],
        "intent": "Prove the abandoned search is emitted exactly once",
        "next": "done",
        "proves": [
          "search-abandon-analytics"
        ]
      },
      "done": {
        "action": "end",
        "status": "pass"
      }
    }
  }
}
