{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Prove live Perps order-cancel analytics",
  "description": "Place a non-marketable testnet limit order, cancel it through visible Extension controls, and prove the submitted/executed event pair exactly once.",
  "paramsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "market": {
        "type": "string",
        "default": "BTC",
        "description": "Perps market symbol used by the live flow."
      },
      "notional": {
        "type": "number",
        "default": 12,
        "description": "Small testnet order notional entered through the visible form."
      },
      "limit_offset_percent": {
        "type": "number",
        "default": 5,
        "description": "Distance from the visible midpoint used to keep the cancellation proof order resting."
      },
      "utm_source": {
        "type": "string",
        "default": "recipe_validation",
        "description": "Attribution source asserted on emitted lifecycle events."
      },
      "utm_medium": {
        "type": "string",
        "default": "automation",
        "description": "Attribution medium asserted on emitted lifecycle events."
      },
      "utm_campaign": {
        "type": "string",
        "default": "perps_analytics",
        "description": "Attribution campaign asserted on emitted lifecycle events."
      }
    }
  },
  "proofTargets": [
    {
      "id": "cancel-order-analytics",
      "claim": "A visible resting-order cancellation emits one submitted and one executed cancellation contract."
    }
  ],
  "workflow": {
    "entry": "ensure-clean-market",
    "teardown": "restore-market",
    "nodes": {
      "ensure-clean-market": {
        "action": "metamask.perps.start_state",
        "profile": "clean_market_testnet",
        "network": "testnet",
        "market": "{{params.market}}",
        "positions": {
          "state": "none",
          "mode": "matching"
        },
        "orders": {
          "state": "none",
          "mode": "matching"
        },
        "page": "home",
        "intent": "Enforce a clean {{params.market}} testnet market before the live proof",
        "next": "open-market"
      },
      "open-market": {
        "action": "ui.navigate",
        "hash": "#/perps/market/{{params.market}}?source=deeplink&utm_source={{params.utm_source}}&utm_medium={{params.utm_medium}}&utm_campaign={{params.utm_campaign}}",
        "intent": "Open the real {{params.market}} market with explicit flow attribution",
        "next": "prove-flat"
      },
      "prove-flat": {
        "action": "ui.wait_for",
        "test_id": "perps-long-cta-button",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Require no existing {{params.market}} position before creating the order",
        "next": "open-long"
      },
      "open-long": {
        "action": "ui.navigate",
        "hash": "#/perps/trade/{{params.market}}?direction=long&mode=new",
        "intent": "Open the visible {{params.market}} long order form",
        "next": "form-ready"
      },
      "form-ready": {
        "action": "ui.wait_for",
        "test_id": "submit-order-button",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Prove the order form is interactive",
        "next": "choose-limit"
      },
      "choose-limit": {
        "action": "ui.press",
        "test_id": "order-type-limit",
        "intent": "Keep the test order resting off market",
        "next": "use-mid-limit-price"
      },
      "set-price": {
        "action": "ui.set_input",
        "selector": "[data-testid=\"limit-price-input\"] input",
        "value": "{{outputs.calculate-resting-limit-price.price}}",
        "intent": "Keep the {{params.market}} buy below the live market",
        "next": "set-size"
      },
      "set-size": {
        "action": "ui.set_input",
        "selector": "[data-testid=\"amount-input-field\"] input",
        "value": "{{params.notional}}",
        "intent": "Limit testnet exposure to {{params.notional}} dollars",
        "next": "order-settled"
      },
      "order-settled": {
        "action": "wait",
        "duration_ms": 1500,
        "intent": "Allow live order calculations to enable submission",
        "next": "submit"
      },
      "submit": {
        "action": "ui.press",
        "test_id": "submit-order-button",
        "intent": "Commit the resting {{params.market}} limit order",
        "next": "order-visible"
      },
      "order-visible": {
        "action": "ui.wait_for",
        "selector": "[data-testid^=\"order-card-\"]",
        "expected": "visible",
        "timeout_ms": 45000,
        "intent": "Prove the limit order is open on the live market",
        "next": "toast-gone"
      },
      "toast-gone": {
        "action": "ui.wait_for",
        "test_id": "perps-toast",
        "visible": false,
        "timeout_ms": 20000,
        "intent": "Keep the open-order control unobstructed",
        "next": "capture"
      },
      "capture": {
        "action": "metamask.analytics.start_capture",
        "intent": "Bracket only the committed cancel lifecycle",
        "next": "open-order"
      },
      "open-order": {
        "action": "ui.press",
        "selector": "[data-testid^=\"order-card-\"]",
        "intent": "Open the real order cancellation",
        "next": "cancel-ready"
      },
      "cancel-ready": {
        "action": "ui.wait_for",
        "test_id": "perps-cancel-order-button",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Prove the cancellation confirmation is available",
        "next": "confirm-cancel"
      },
      "confirm-cancel": {
        "action": "ui.press",
        "test_id": "perps-cancel-order-button",
        "intent": "Cancel the complete {{params.market}} limit order",
        "next": "order-gone"
      },
      "order-gone": {
        "action": "ui.wait_for",
        "selector": "[data-testid^=\"order-card-\"]",
        "visible": false,
        "timeout_ms": 45000,
        "intent": "Prove the {{params.market}} order no longer rests on the market",
        "next": "assert-cancel"
      },
      "assert-cancel": {
        "action": "metamask.analytics.assert_events",
        "since": "{{outputs.capture.cursor}}",
        "timeout_ms": 15000,
        "settle_ms": 2000,
        "expect": [
          {
            "event": "Perp Order Cancel Transaction",
            "count": 2
          },
          {
            "event": "Perp Order Cancel Transaction",
            "count": 1,
            "properties": {
              "status": "submitted",
              "asset": "{{params.market}}",
              "entry_point": "deeplink",
              "discovery_source": "deeplink",
              "utm_source": "{{params.utm_source}}",
              "utm_medium": "{{params.utm_medium}}",
              "utm_campaign": "{{params.utm_campaign}}",
              "environment_type": "background"
            }
          },
          {
            "event": "Perp Order Cancel Transaction",
            "count": 1,
            "properties": {
              "status": "executed",
              "asset": "{{params.market}}",
              "entry_point": "deeplink",
              "discovery_source": "deeplink",
              "utm_source": "{{params.utm_source}}",
              "utm_medium": "{{params.utm_medium}}",
              "utm_campaign": "{{params.utm_campaign}}",
              "environment_type": "background"
            }
          }
        ],
        "intent": "Prove the cancel submitted and executed once with the complete contract",
        "next": "done",
        "proves": [
          "cancel-order-analytics"
        ]
      },
      "done": {
        "action": "end",
        "status": "pass"
      },
      "restore-market": {
        "action": "metamask.perps.start_state",
        "profile": "clean_market_testnet",
        "network": "testnet",
        "market": "{{params.market}}",
        "positions": {
          "state": "none",
          "mode": "matching"
        },
        "orders": {
          "state": "none",
          "mode": "matching"
        },
        "page": "home",
        "intent": "Restore the selected testnet market even when the proof fails",
        "next": "teardown-done"
      },
      "teardown-done": {
        "action": "end",
        "status": "pass"
      },
      "use-mid-limit-price": {
        "action": "ui.press",
        "test_id": "limit-price-mid-button",
        "intent": "Load the visible midpoint before deriving a resting price",
        "next": "calculate-resting-limit-price"
      },
      "calculate-resting-limit-price": {
        "action": "metamask.perps.calculate_resting_limit_price",
        "side": "long",
        "offset_percent": "{{params.limit_offset_percent}}",
        "intent": "Derive a reusable resting long price from the live midpoint",
        "next": "set-price"
      }
    }
  }
}
