{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Prove live Perps trade and close analytics",
  "description": "Place and close a small testnet position through visible Extension controls, proving the submitted and executed analytics pairs exactly once.",
  "paramsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "market": {
        "type": "string",
        "default": "BTC",
        "description": "Perps market symbol used by the live flow."
      },
      "notional": {
        "type": "number",
        "default": 12,
        "description": "Small testnet order notional entered through the visible form."
      },
      "utm_source": {
        "type": "string",
        "default": "recipe_validation",
        "description": "Attribution source asserted on emitted lifecycle events."
      },
      "utm_medium": {
        "type": "string",
        "default": "automation",
        "description": "Attribution medium asserted on emitted lifecycle events."
      },
      "utm_campaign": {
        "type": "string",
        "default": "perps_analytics",
        "description": "Attribution campaign asserted on emitted lifecycle events."
      }
    }
  },
  "proofTargets": [
    {
      "id": "trade-close-analytics",
      "claim": "A committed market trade and full close each emit one submitted and one executed contract."
    }
  ],
  "workflow": {
    "entry": "ensure-clean-market",
    "teardown": "restore-market",
    "nodes": {
      "ensure-clean-market": {
        "action": "metamask.perps.start_state",
        "profile": "clean_market_testnet",
        "network": "testnet",
        "market": "{{params.market}}",
        "positions": {
          "state": "none",
          "mode": "matching"
        },
        "orders": {
          "state": "none",
          "mode": "matching"
        },
        "page": "home",
        "intent": "Enforce a clean {{params.market}} testnet market before the live proof",
        "next": "open-market"
      },
      "open-market": {
        "action": "ui.navigate",
        "hash": "#/perps/market/{{params.market}}?source=deeplink&utm_source={{params.utm_source}}&utm_medium={{params.utm_medium}}&utm_campaign={{params.utm_campaign}}",
        "intent": "Open the real {{params.market}} market",
        "next": "prove-flat"
      },
      "prove-flat": {
        "action": "ui.wait_for",
        "test_id": "perps-long-cta-button",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Require no existing {{params.market}} position before the proof",
        "next": "open-long"
      },
      "open-long": {
        "action": "ui.navigate",
        "hash": "#/perps/trade/{{params.market}}?direction=long&mode=new",
        "intent": "Open the visible {{params.market}} long order form",
        "next": "form-ready"
      },
      "form-ready": {
        "action": "ui.wait_for",
        "test_id": "submit-order-button",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Prove the order form is interactive",
        "next": "size"
      },
      "size": {
        "action": "ui.set_input",
        "selector": "input[inputmode=\"decimal\"]",
        "value": "{{params.notional}}",
        "intent": "Limit testnet exposure to {{params.notional}} dollars",
        "next": "size-settled"
      },
      "size-settled": {
        "action": "wait",
        "duration_ms": 1500,
        "intent": "Allow live order calculations to enable submission",
        "next": "capture"
      },
      "capture": {
        "action": "metamask.analytics.start_capture",
        "intent": "Bracket only the committed trade and close lifecycle",
        "next": "submit"
      },
      "submit": {
        "action": "ui.press",
        "test_id": "submit-order-button",
        "intent": "Submit the real {{params.market}} market order",
        "next": "position-visible"
      },
      "position-visible": {
        "action": "ui.wait_for",
        "test_id": "perps-close-cta-button",
        "expected": "visible",
        "timeout_ms": 45000,
        "intent": "Prove the submitted order became an open {{params.market}} position",
        "next": "assert-trade"
      },
      "assert-trade": {
        "action": "metamask.analytics.assert_events",
        "since": "{{outputs.capture.cursor}}",
        "timeout_ms": 15000,
        "settle_ms": 2000,
        "expect": [
          {
            "event": "Perp Trade Transaction",
            "count": 2
          },
          {
            "event": "Perp Trade Transaction",
            "count": 1,
            "properties": {
              "status": "submitted",
              "asset": "{{params.market}}",
              "direction": "long",
              "order_type": "market",
              "leverage": 3,
              "entry_point": "trade_screen",
              "hl_fee_rate": 0.000432,
              "utm_source": "{{params.utm_source}}",
              "utm_medium": "{{params.utm_medium}}",
              "utm_campaign": "{{params.utm_campaign}}",
              "environment_type": "background"
            }
          },
          {
            "event": "Perp Trade Transaction",
            "count": 1,
            "properties": {
              "status": "executed",
              "asset": "{{params.market}}",
              "direction": "long",
              "order_type": "market",
              "leverage": 3,
              "action": "create_position",
              "trade_with_token": false,
              "mm_pay_token_selected": "Perps Balance",
              "entry_point": "trade_screen",
              "hl_fee_rate": 0.000432,
              "utm_source": "{{params.utm_source}}",
              "utm_medium": "{{params.utm_medium}}",
              "utm_campaign": "{{params.utm_campaign}}",
              "environment_type": "background"
            }
          }
        ],
        "intent": "Prove the trade submitted and executed once with the complete contract",
        "next": "trade-toast-gone",
        "proves": [
          "trade-close-analytics"
        ]
      },
      "trade-toast-gone": {
        "action": "ui.wait_for",
        "test_id": "perps-toast",
        "visible": false,
        "timeout_ms": 20000,
        "intent": "Keep the close control unobstructed",
        "next": "open-close"
      },
      "open-close": {
        "action": "ui.press",
        "test_id": "perps-close-cta-button",
        "intent": "Open the close-position modal through the visible CTA",
        "next": "close-ready"
      },
      "close-ready": {
        "action": "ui.wait_for",
        "test_id": "perps-close-position-modal-submit",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Prove the close confirmation is available",
        "next": "confirm-close"
      },
      "confirm-close": {
        "action": "ui.press",
        "test_id": "perps-close-position-modal-submit",
        "intent": "Close the complete {{params.market}} position through the real modal",
        "next": "flat-visible"
      },
      "flat-visible": {
        "action": "ui.wait_for",
        "test_id": "perps-long-cta-button",
        "expected": "visible",
        "timeout_ms": 45000,
        "intent": "Prove the {{params.market}} position is closed",
        "next": "assert-close"
      },
      "assert-close": {
        "action": "metamask.analytics.assert_events",
        "since": "{{outputs.capture.cursor}}",
        "timeout_ms": 15000,
        "settle_ms": 2000,
        "expect": [
          {
            "event": "Perp Position Close Transaction",
            "count": 2
          },
          {
            "event": "Perp Position Close Transaction",
            "count": 1,
            "properties": {
              "status": "submitted",
              "asset": "{{params.market}}",
              "order_type": "market",
              "entry_point": "deeplink",
              "discovery_source": "deeplink",
              "hl_fee_rate": 0.000432,
              "utm_source": "{{params.utm_source}}",
              "utm_medium": "{{params.utm_medium}}",
              "utm_campaign": "{{params.utm_campaign}}",
              "environment_type": "background"
            }
          },
          {
            "event": "Perp Position Close Transaction",
            "count": 1,
            "properties": {
              "status": "executed",
              "asset": "{{params.market}}",
              "direction": "long",
              "order_type": "market",
              "percentage_closed": 100,
              "leverage": 3,
              "entry_point": "deeplink",
              "discovery_source": "deeplink",
              "hl_fee_rate": 0.000432,
              "close_type": "full",
              "utm_source": "{{params.utm_source}}",
              "utm_medium": "{{params.utm_medium}}",
              "utm_campaign": "{{params.utm_campaign}}",
              "environment_type": "background"
            }
          }
        ],
        "intent": "Prove the close submitted and executed once with the complete contract",
        "next": "done",
        "proves": [
          "trade-close-analytics"
        ]
      },
      "done": {
        "action": "end",
        "status": "pass"
      },
      "restore-market": {
        "action": "metamask.perps.start_state",
        "profile": "clean_market_testnet",
        "network": "testnet",
        "market": "{{params.market}}",
        "positions": {
          "state": "none",
          "mode": "matching"
        },
        "orders": {
          "state": "none",
          "mode": "matching"
        },
        "page": "home",
        "intent": "Restore the selected testnet market even when the proof fails",
        "next": "teardown-done"
      },
      "teardown-done": {
        "action": "end",
        "status": "pass"
      }
    }
  }
}
