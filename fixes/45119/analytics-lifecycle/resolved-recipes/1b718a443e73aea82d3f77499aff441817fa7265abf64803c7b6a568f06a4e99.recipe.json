{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Prove live Perps margin screens and flip analytics",
  "description": "Open a small testnet position, prove both margin screen contracts, reverse it through visible controls, prove the submitted/executed flip pair, and close it.",
  "paramsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "market": {
        "type": "string",
        "default": "BTC",
        "description": "Perps market symbol used by the live flow."
      },
      "notional": {
        "type": "number",
        "default": 12,
        "description": "Small testnet order notional entered through the visible form."
      },
      "utm_source": {
        "type": "string",
        "default": "recipe_validation",
        "description": "Attribution source asserted on emitted lifecycle events."
      },
      "utm_medium": {
        "type": "string",
        "default": "automation",
        "description": "Attribution medium asserted on emitted lifecycle events."
      },
      "utm_campaign": {
        "type": "string",
        "default": "perps_analytics",
        "description": "Attribution campaign asserted on emitted lifecycle events."
      }
    }
  },
  "proofTargets": [
    {
      "id": "margin-flip-analytics",
      "claim": "Visible margin screens and a committed position reversal emit their exact analytics contracts."
    }
  ],
  "workflow": {
    "entry": "ensure-clean-market",
    "teardown": "restore-market",
    "nodes": {
      "ensure-clean-market": {
        "action": "metamask.perps.start_state",
        "profile": "clean_market_testnet",
        "network": "testnet",
        "market": "{{params.market}}",
        "positions": {
          "state": "none",
          "mode": "matching"
        },
        "orders": {
          "state": "none",
          "mode": "matching"
        },
        "page": "home",
        "intent": "Enforce a clean {{params.market}} testnet market before the live proof",
        "next": "open-market"
      },
      "open-market": {
        "action": "ui.navigate",
        "hash": "#/perps/market/{{params.market}}?source=deeplink&utm_source={{params.utm_source}}&utm_medium={{params.utm_medium}}&utm_campaign={{params.utm_campaign}}",
        "intent": "Open the real {{params.market}} market with explicit flow attribution",
        "next": "prove-flat"
      },
      "prove-flat": {
        "action": "ui.wait_for",
        "test_id": "perps-long-cta-button",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Require no existing {{params.market}} position before the proof",
        "next": "open-long"
      },
      "open-long": {
        "action": "ui.navigate",
        "hash": "#/perps/trade/{{params.market}}?direction=long&mode=new",
        "intent": "Open the visible {{params.market}} long order form",
        "next": "form-ready"
      },
      "form-ready": {
        "action": "ui.wait_for",
        "test_id": "submit-order-button",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Prove the order form is interactive",
        "next": "size"
      },
      "size": {
        "action": "ui.set_input",
        "selector": "input[inputmode=\"decimal\"]",
        "value": "{{params.notional}}",
        "intent": "Limit testnet exposure to {{params.notional}} dollars",
        "next": "size-settled"
      },
      "size-settled": {
        "action": "wait",
        "duration_ms": 1500,
        "intent": "Allow live order calculations to enable submission",
        "next": "submit"
      },
      "submit": {
        "action": "ui.press",
        "test_id": "submit-order-button",
        "intent": "Commit the real {{params.market}} market order",
        "next": "position-visible"
      },
      "position-visible": {
        "action": "ui.wait_for",
        "test_id": "perps-margin-card",
        "expected": "visible",
        "timeout_ms": 45000,
        "intent": "Prove the submitted order became an open {{params.market}} position",
        "next": "toast-gone"
      },
      "toast-gone": {
        "action": "ui.wait_for",
        "test_id": "perps-toast",
        "visible": false,
        "timeout_ms": 20000,
        "intent": "Keep the position controls unobstructed",
        "next": "capture-margin"
      },
      "capture-margin": {
        "action": "metamask.analytics.start_capture",
        "intent": "Bracket both live margin screens",
        "next": "open-margin-menu-add"
      },
      "open-margin-menu-add": {
        "action": "ui.press",
        "test_id": "perps-margin-card",
        "intent": "Open the position margin choices",
        "next": "open-add-margin"
      },
      "open-add-margin": {
        "action": "ui.press",
        "test_id": "perps-margin-menu-add",
        "intent": "Open the live add-margin screen",
        "next": "add-margin-ready"
      },
      "add-margin-ready": {
        "action": "ui.wait_for",
        "test_id": "perps-edit-margin-modal-cancel",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Anchor analytics to the rendered add-margin screen",
        "next": "close-add-margin"
      },
      "close-add-margin": {
        "action": "ui.press",
        "test_id": "perps-edit-margin-modal-cancel",
        "intent": "Leave margin unchanged after observing the add screen",
        "next": "open-margin-menu-remove"
      },
      "open-margin-menu-remove": {
        "action": "ui.press",
        "test_id": "perps-margin-card",
        "intent": "Open the position margin choices again",
        "next": "open-remove-margin"
      },
      "open-remove-margin": {
        "action": "ui.press",
        "test_id": "perps-margin-menu-remove",
        "intent": "Open the live remove-margin screen",
        "next": "remove-margin-ready"
      },
      "remove-margin-ready": {
        "action": "ui.wait_for",
        "test_id": "perps-edit-margin-modal-cancel",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Anchor analytics to the rendered remove-margin screen",
        "next": "assert-margin"
      },
      "assert-margin": {
        "action": "metamask.analytics.assert_events",
        "since": "{{outputs.capture-margin.cursor}}",
        "timeout_ms": 15000,
        "settle_ms": 1500,
        "expect": [
          {
            "event": "Perp Screen Viewed",
            "count": 2
          },
          {
            "event": "Perp Screen Viewed",
            "count": 1,
            "properties": {
              "screen_type": "add_margin",
              "asset": "{{params.market}}",
              "source": "deeplink",
              "utm_source": "{{params.utm_source}}",
              "utm_medium": "{{params.utm_medium}}",
              "utm_campaign": "{{params.utm_campaign}}",
              "environment_type": "fullscreen"
            }
          },
          {
            "event": "Perp Screen Viewed",
            "count": 1,
            "properties": {
              "screen_type": "remove_margin",
              "asset": "{{params.market}}",
              "source": "deeplink",
              "utm_source": "{{params.utm_source}}",
              "utm_medium": "{{params.utm_medium}}",
              "utm_campaign": "{{params.utm_campaign}}",
              "environment_type": "fullscreen"
            }
          }
        ],
        "intent": "Prove each visible margin screen emitted its complete contract once",
        "next": "close-remove-margin",
        "proves": [
          "margin-flip-analytics"
        ]
      },
      "close-remove-margin": {
        "action": "ui.press",
        "test_id": "perps-edit-margin-modal-cancel",
        "intent": "Leave margin unchanged after observing the remove screen",
        "next": "capture-flip"
      },
      "capture-flip": {
        "action": "metamask.analytics.start_capture",
        "intent": "Bracket only the committed position reversal",
        "next": "open-modify"
      },
      "open-modify": {
        "action": "ui.press",
        "test_id": "perps-modify-cta-button",
        "intent": "Open the live position-management choices",
        "next": "open-reverse"
      },
      "open-reverse": {
        "action": "ui.press",
        "test_id": "perps-modify-menu-reverse-position",
        "intent": "Open the {{params.market}} reversal confirmation",
        "next": "reverse-ready"
      },
      "reverse-ready": {
        "action": "ui.wait_for",
        "test_id": "perps-reverse-position-modal-save",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Prove the reversal confirmation is available",
        "next": "confirm-reverse"
      },
      "confirm-reverse": {
        "action": "ui.press",
        "test_id": "perps-reverse-position-modal-save",
        "intent": "Reverse the live {{params.market}} position from long to short",
        "next": "short-visible"
      },
      "short-visible": {
        "action": "ui.wait_for",
        "test_id": "perps-position-leverage",
        "text": "Short",
        "expected": "visible",
        "timeout_ms": 45000,
        "intent": "Prove the reversed position card is visibly settled",
        "next": "assert-short-state"
      },
      "assert-short-state": {
        "action": "metamask.perps.assert_positions",
        "market": "{{params.market}}",
        "side": "short",
        "state": "open",
        "intent": "Confirm the visible card represents a short {{params.market}} position",
        "next": "assert-flip"
      },
      "assert-flip": {
        "action": "metamask.analytics.assert_events",
        "since": "{{outputs.capture-flip.cursor}}",
        "timeout_ms": 15000,
        "settle_ms": 2000,
        "expect": [
          {
            "event": "Perp Trade Transaction",
            "count": 2
          },
          {
            "event": "Perp Trade Transaction",
            "count": 1,
            "properties": {
              "status": "submitted",
              "asset": "{{params.market}}",
              "direction": "short",
              "order_type": "market",
              "leverage": 3,
              "order_size": {
                "$type": "number",
                "$gt": 0
              },
              "action": "flip_long_to_short",
              "entry_point": "deeplink",
              "discovery_source": "deeplink",
              "hl_fee_rate": 0.000432,
              "utm_source": "{{params.utm_source}}",
              "utm_medium": "{{params.utm_medium}}",
              "utm_campaign": "{{params.utm_campaign}}",
              "environment_type": "background"
            }
          },
          {
            "event": "Perp Trade Transaction",
            "count": 1,
            "properties": {
              "status": "executed",
              "asset": "{{params.market}}",
              "direction": "short",
              "order_type": "market",
              "leverage": 3,
              "order_size": {
                "$type": "number",
                "$gt": 0
              },
              "action": "flip_long_to_short",
              "metamask_fee": {
                "$type": "number",
                "$gt": 0
              },
              "order_value": {
                "$type": "number",
                "$gt": 0
              },
              "completion_duration": {
                "$type": "number",
                "$gt": 0
              },
              "entry_point": "deeplink",
              "discovery_source": "deeplink",
              "hl_fee_rate": 0.000432,
              "utm_source": "{{params.utm_source}}",
              "utm_medium": "{{params.utm_medium}}",
              "utm_campaign": "{{params.utm_campaign}}",
              "environment_type": "background"
            }
          }
        ],
        "intent": "Prove the flip submitted and executed once with fee and attribution",
        "next": "flip-toast-gone",
        "proves": [
          "margin-flip-analytics"
        ]
      },
      "flip-toast-gone": {
        "action": "ui.wait_for",
        "test_id": "perps-toast",
        "visible": false,
        "timeout_ms": 20000,
        "intent": "Keep the position close unobstructed",
        "next": "open-close"
      },
      "open-close": {
        "action": "ui.press",
        "test_id": "perps-close-cta-button",
        "intent": "Open the reversed-position cleanup",
        "next": "close-ready"
      },
      "close-ready": {
        "action": "ui.wait_for",
        "test_id": "perps-close-position-modal-submit",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Prove the close confirmation is available",
        "next": "confirm-close"
      },
      "confirm-close": {
        "action": "ui.press",
        "test_id": "perps-close-position-modal-submit",
        "intent": "Close the complete short {{params.market}} position",
        "next": "flat-visible"
      },
      "flat-visible": {
        "action": "ui.wait_for",
        "test_id": "perps-long-cta-button",
        "expected": "visible",
        "timeout_ms": 45000,
        "intent": "Prove the {{params.market}} position cleanup completed",
        "next": "done"
      },
      "done": {
        "action": "end",
        "status": "pass"
      },
      "restore-market": {
        "action": "metamask.perps.start_state",
        "profile": "clean_market_testnet",
        "network": "testnet",
        "market": "{{params.market}}",
        "positions": {
          "state": "none",
          "mode": "matching"
        },
        "orders": {
          "state": "none",
          "mode": "matching"
        },
        "page": "home",
        "intent": "Restore the selected testnet market even when the proof fails",
        "next": "teardown-done"
      },
      "teardown-done": {
        "action": "end",
        "status": "pass"
      }
    }
  }
}
