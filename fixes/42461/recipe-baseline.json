          },
          "next": "ac4-screenshot-eth"
        },
        "ac4-screenshot-eth": {
          "action": "screenshot",
          "filename": "before-evidence-ac4-eth-tpsl-price.png",
          "note": "AC4: ETH TP price generated from 7% pre-fix displays with incorrect at most 1 decimal place.",
          "next": "teardown-done"
        },
        "teardown-done": {
          "action": "end",
          "status": "pass"
        }
      }
    }
  }
}
