{
  "title": "Probe TP/SL modal",
  "validate": {
    "workflow": {
      "pre_conditions": ["wallet.unlocked", "perps.feature_enabled"],
      "entry": "scroll-row",
      "nodes": {
        "scroll-row": { "action": "scroll", "test_id": "perps-auto-close-row", "next": "open-modal" },
        "open-modal": { "action": "press", "test_id": "perps-auto-close-row", "next": "probe" },
        "probe": { "action": "eval_sync", "expression": "JSON.stringify({hash:location.hash,autoClose:!!document.querySelector('[data-testid=perps-auto-close-row]'),modal:{exists:!!document.querySelector('[data-testid=perps-update-tpsl-modal]'),style:document.querySelector('[data-testid=perps-update-tpsl-modal]')?.getAttribute('style'),classes:document.querySelector('[data-testid=perps-update-tpsl-modal]')?.className,rect:(()=>{const e=document.querySelector('[data-testid=perps-update-tpsl-modal]'); if(!e)return null; const r=e.getBoundingClientRect(); return {x:r.x,y:r.y,w:r.width,h:r.height}})()},inputs:[...document.querySelectorAll('input')].map((el,i)=>({i,placeholder:el.getAttribute('placeholder'),value:el.value,type:el.type,testid:el.getAttribute('data-testid'),html:el.outerHTML.slice(0,300)})), text:document.body.innerText.slice(0,1500)})", "save_as": "probe", "next": "shot" },
        "shot": { "action": "screenshot", "filename": "baseline-tpsl-modal", "next": "done" },
        "done": { "action": "end", "status": "pass" }
      }
    }
  }
}
