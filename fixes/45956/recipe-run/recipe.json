{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "PR 45956 review fix: Products chips follow the controller order",
  "description": "Live proof that the Perps tab Products chips come from the controller's MARKET_CATEGORIES order (plus new) and wrap instead of scrolling.",
  "workflow": {
    "entry": "attach",
    "nodes": {
      "attach": {
        "action": "cdp.target",
        "cdp_port": 6663,
        "require_reachable": true,
        "intent": "Refuse to report proof unless the live extension is attached",
        "next": "reload-extension-page"
      },
      "reload-extension-page": {
        "action": "command",
        "cmd": "node -e \"(async()=>{const t=(await (await fetch('http://127.0.0.1:6663/json')).json()).find(x=>x.type==='page'&&x.url.includes('home.html'));const ws=new WebSocket(t.webSocketDebuggerUrl);ws.onopen=()=>ws.send(JSON.stringify({id:1,method:'Page.reload',params:{ignoreCache:true}}));ws.onmessage=()=>{ws.close();process.exit(0)};setTimeout(()=>process.exit(1),10000)})()\"",
        "timeout_ms": 20000,
        "intent": "Load the rebuilt bundle; webpack has no HMR for the extension page",
        "next": "settle-after-reload"
      },
      "settle-after-reload": {
        "action": "wait",
        "duration_ms": 4000,
        "intent": "Let the reloaded page boot before driving it",
        "next": "unlock"
      },
      "unlock": {
        "action": "metamask.wallet.ensure_unlocked",
        "timeout_ms": 60000,
        "intent": "Reach the wallet UI from the fixture wallet",
        "next": "open-perps-tab"
      },
      "open-perps-tab": {
        "action": "ui.navigate",
        "page": "perps",
        "intent": "Put the user on the Perps tab where the Products section lives",
        "next": "wait-products"
      },
      "wait-products": {
        "action": "ui.wait_for",
        "test_id": "perps-products-categories",
        "expected": "visible",
        "timeout_ms": 45000,
        "intent": "Products chips rendered after the first market snapshot",
        "next": "scroll-products"
      },
      "scroll-products": {
        "action": "ui.scroll",
        "test_id": "perps-products-categories",
        "scroll_into_view": true,
        "timeout_ms": 20000,
        "intent": "Judge the chips on what a user can see",
        "next": "assert-wraps"
      },
      "assert-wraps": {
        "action": "ui.wait_for",
        "selector": "[data-testid=\"perps-products-categories\"].flex-wrap[role=\"group\"]",
        "expected": "visible",
        "timeout_ms": 10000,
        "intent": "Chips wrap onto further lines instead of scrolling or hiding",
        "next": "assert-first-crypto"
      },
      "assert-first-crypto": {
        "action": "ui.wait_for",
        "selector": "[data-testid=\"perps-products-categories\"] > [data-testid=\"perps-products-categories-pill-crypto\"]:nth-child(1)",
        "expected": "visible",
        "timeout_ms": 10000,
        "intent": "Controller order starts with crypto",
        "next": "assert-index-fourth"
      },
      "assert-index-fourth": {
        "action": "ui.wait_for",
        "selector": "[data-testid=\"perps-products-categories\"] > [data-testid=\"perps-products-categories-pill-index\"]:nth-child(4)",
        "expected": "visible",
        "timeout_ms": 10000,
        "intent": "index sits right after pre-ipo, as in MARKET_CATEGORIES, not after commodity as the removed hand-kept order had it",
        "next": "assert-commodity-sixth"
      },
      "assert-commodity-sixth": {
        "action": "ui.wait_for",
        "selector": "[data-testid=\"perps-products-categories\"] > [data-testid=\"perps-products-categories-pill-commodity\"]:nth-child(6)",
        "expected": "visible",
        "timeout_ms": 10000,
        "intent": "commodity follows etf, as in MARKET_CATEGORIES",
        "next": "assert-new-last"
      },
      "assert-new-last": {
        "action": "ui.wait_for",
        "selector": "[data-testid=\"perps-products-categories\"] > [data-testid=\"perps-products-categories-pill-new\"]:nth-child(8):last-child",
        "expected": "visible",
        "timeout_ms": 10000,
        "intent": "new is appended after every controller category, matching the market list rail",
        "next": "clear-capture-orphans"
      },
      "clear-capture-orphans": {
        "action": "command",
        "cmd": "pkill -9 -f 'capture-helper' || true",
        "intent": "Keep the capture on the real screenshot provider",
        "next": "screenshot-products"
      },
      "screenshot-products": {
        "action": "ui.screenshot",
        "path": "screenshots/products-controller-order.png",
        "label": "Products chips in the controller's category order, wrapping",
        "next": "done",
        "intent": "Show the reader the Products chips in controller order"
      },
      "done": {
        "action": "end",
        "status": "pass"
      }
    }
  }
}
