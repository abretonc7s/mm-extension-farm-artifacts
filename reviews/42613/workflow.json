{
  "description": "",
  "hooks": {
    "pre_conditions": [
      "wallet.unlocked",
      "perps.feature_enabled"
    ],
    "setup": [
      {
        "id": "setup-nav-perps",
        "action": "call",
        "ref": "perps/navigate-perps-tab"
      }
    ],
    "teardown": []
  },
  "inputs": {},
  "playback": {
    "mode": "off",
    "slow_ms": 1000
  },
  "sourcePath": "",
  "title": "PR #42613 — close-all-positions confirmation modal (AC1, AC2, AC4)",
  "workflow": {
    "entry": "ac1-assert-close-all-button-visible",
    "nodes": {
      "ac1-assert-close-all-button-visible": {
        "action": "ext_check_dom",
        "test_id": "perps-close-all-positions",
        "visible": true,
        "next": "ac1-assert-positions-present",
        "id": "ac1-assert-close-all-button-visible"
      },
      "ac1-assert-positions-present": {
        "action": "eval_sync",
        "expression": "(function(){var cards=document.querySelectorAll('[data-testid^=\"position-card-\"]');var real=[...cards].filter(function(c){return !/-roe-/u.test(c.getAttribute('data-testid'))});return JSON.stringify({positionCount:real.length})})()",
        "assert": {
          "operator": "gt",
          "field": "positionCount",
          "value": 0
        },
        "save_as": "positions_before",
        "next": "ac1-screenshot-close-all-button",
        "id": "ac1-assert-positions-present"
      },
      "ac1-screenshot-close-all-button": {
        "action": "screenshot",
        "filename": "evidence-ac1-close-all-button-visible",
        "note": "AC1: Close all button visible in Positions section with open positions",
        "next": "ac2-open-confirmation-modal",
        "id": "ac1-screenshot-close-all-button"
      },
      "ac2-open-confirmation-modal": {
        "action": "press",
        "test_id": "perps-close-all-positions",
        "next": "ac2-wait-modal-submit",
        "id": "ac2-open-confirmation-modal"
      },
      "ac2-wait-modal-submit": {
        "action": "wait_for",
        "test_id": "perps-close-all-positions-modal-submit",
        "timeout_ms": 10000,
        "next": "ac2-wait-fees-loaded",
        "id": "ac2-wait-modal-submit"
      },
      "ac2-wait-fees-loaded": {
        "action": "wait_for",
        "expression": "(function(){var el=document.querySelector('[data-testid=\"perps-close-all-fees-value\"]');return JSON.stringify({ready: !!el && el.textContent.trim() !== '--'})})()",
        "assert": {
          "operator": "eq",
          "field": "ready",
          "value": true
        },
        "timeout_ms": 10000,
        "next": "ac2-assert-summary-rows",
        "id": "ac2-wait-fees-loaded"
      },
      "ac2-assert-summary-rows": {
        "action": "eval_sync",
        "expression": "(function(){var q=function(id){var e=document.querySelector('[data-testid=\"'+id+'\"]');return e?e.textContent.trim():null};return JSON.stringify({margin:q('perps-close-all-total-margin-value'),fees:q('perps-close-all-fees-value'),receive:q('perps-close-all-receive-value'),cancel:q('perps-close-all-positions-modal-cancel'),submit:q('perps-close-all-positions-modal-submit')})})()",
        "assert": {
          "all": [
            {
              "operator": "not_null",
              "field": "margin"
            },
            {
              "operator": "not_null",
              "field": "fees"
            },
            {
              "operator": "not_null",
              "field": "receive"
            },
            {
              "operator": "contains",
              "field": "fees",
              "value": "-$"
            }
          ]
        },
        "save_as": "modal_summary",
        "next": "ac2-screenshot-confirmation-modal",
        "id": "ac2-assert-summary-rows"
      },
      "ac2-screenshot-confirmation-modal": {
        "action": "screenshot",
        "filename": "evidence-ac2-confirmation-modal",
        "note": "AC2: confirmation modal shows margin, fees and you-will-receive",
        "next": "ac4-cancel-keep-positions",
        "id": "ac2-screenshot-confirmation-modal"
      },
      "ac4-cancel-keep-positions": {
        "action": "press",
        "test_id": "perps-close-all-positions-modal-cancel",
        "next": "ac4-wait-modal-gone",
        "id": "ac4-cancel-keep-positions"
      },
      "ac4-wait-modal-gone": {
        "action": "wait_for",
        "expression": "(function(){return JSON.stringify({gone: !document.querySelector('[data-testid=\"perps-close-all-positions-modal-submit\"]')})})()",
        "assert": {
          "operator": "eq",
          "field": "gone",
          "value": true
        },
        "timeout_ms": 8000,
        "next": "ac4-assert-positions-intact",
        "id": "ac4-wait-modal-gone"
      },
      "ac4-assert-positions-intact": {
        "action": "eval_sync",
        "expression": "(function(){var cards=document.querySelectorAll('[data-testid^=\"position-card-\"]');var real=[...cards].filter(function(c){return !/-roe-/u.test(c.getAttribute('data-testid'))});var onPerps=!!document.querySelector('[data-testid=\"perps-positions-section\"]');return JSON.stringify({positionCount:real.length,onPerpsTab:onPerps})})()",
        "assert": {
          "all": [
            {
              "operator": "gt",
              "field": "positionCount",
              "value": 0
            },
            {
              "operator": "eq",
              "field": "onPerpsTab",
              "value": true
            }
          ]
        },
        "save_as": "positions_after",
        "next": "ac4-screenshot-positions-intact",
        "id": "ac4-assert-positions-intact"
      },
      "ac4-screenshot-positions-intact": {
        "action": "screenshot",
        "filename": "evidence-ac4-cancelled-positions-intact",
        "note": "AC4: Keep positions dismisses modal and positions remain on Perps tab",
        "next": "done",
        "id": "ac4-screenshot-positions-intact"
      },
      "done": {
        "action": "end",
        "status": "pass",
        "id": "done"
      }
    }
  }
}