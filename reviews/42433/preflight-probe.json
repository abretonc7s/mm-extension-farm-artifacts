{
  "title": "PR 42433 compliance preflight probe",
  "description": "Probe perps state needed to decide recipe prerequisites.",
  "schema_version": 1,
  "validate": {
    "workflow": {
      "pre_conditions": [
        "wallet.unlocked",
        "perps.feature_enabled"
      ],
      "entry": "ac1-probe-state",
      "nodes": {
        "ac1-probe-state": {
          "action": "eval_ref",
          "ref": "perps-state",
          "save_as": "perps_state",
          "next": "ac1-probe-positions"
        },
        "ac1-probe-positions": {
          "action": "eval_ref",
          "ref": "perps-positions",
          "save_as": "perps_positions",
          "next": "ac2-probe-balance"
        },
        "ac2-probe-balance": {
          "action": "eval_ref",
          "ref": "perps-balance",
          "save_as": "perps_balance",
          "next": "ac2-probe-markets"
        },
        "ac2-probe-markets": {
          "action": "eval_ref",
          "ref": "perps-markets",
          "save_as": "perps_markets",
          "next": "done"
        },
        "done": {
          "action": "end",
          "status": "pass"
        }
      }
    }
  }
}
